# Server
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase (Postgres Database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Redis (Local Docker or Upstash)
REDIS_URL=redis://localhost:6379

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_KB_COLLECTION=fresher_ai_knowledge

# Embedding Service
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768

# AI Engine - Groq
GROQ_API_KEY=your_groq_api_key
GROQ_FAST_MODEL=llama-3.3-70b-versatile
GROQ_COMPLEX_MODEL=openai/gpt-oss-120b
LLM_MODEL=llama-3.3-70b-versatile

# AI Engine - Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_FAST_MODEL=gemini-2.0-flash
GEMINI_COMPLEX_MODEL=gemini-2.5-pro

# Firebase Admin (Optional / For Google OAuth Token Verification)
FIREBASE_SERVICE_ACCOUNT_PATH=app/config/serviceAccountKey.json

# Razorpay (Billing & Coins)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Official Support (Configurable by site owner)
SUPPORT_EMAIL=support@fresherai.com
SUPPORT_PHONE=
SUPPORT_URL=https://fresherai-silk.vercel.app
